<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.company</groupId>
    <artifactId>campaign-ai-builder</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>campaign-ai-builder</name>
    <description>Campaign AI Builder modular monolith</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Pinned library versions. No floating/latest versions anywhere in this build. -->
        <mybatis-plus-spring-boot3-starter.version>3.5.17</mybatis-plus-spring-boot3-starter.version>

        <!-- Pinned plugin versions. No floating/latest versions anywhere in this build. -->
        <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
        <spring-boot-maven-plugin.version>${project.parent.version}</spring-boot-maven-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Canonical JSON/hash contracts need Jackson directly; it must not arrive transitively by accident. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- T09C needs MVC and MockMvc only; no WebFlux and no security defaults. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          T26 opt-in real PostgreSQL readiness integration.

          These are pinned through the Spring Boot 3.5.16 BOM (Flyway 11.7.2, PostgreSQL JDBC 42.7.11,
          HikariCP 6.3.3), so no floating version is introduced. The JDBC starter, the driver and Flyway
          are present on the classpath but every one of them stays dormant unless the host explicitly
          enables `campaign.readiness.postgres.enabled`. Nothing here creates an embedded database, and no
          unit test depends on an installed PostgreSQL.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <!-- compile scope because MyBatis-Plus type handlers reference PGobject at compile time -->
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway 10+ needs the engine module for PostgreSQL support; it is never loaded for another engine. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
          Unified MyBatis-Plus persistence for PostgreSQL business tables.
          The starter pulls in MyBatis 3.5.x, MyBatis-Plus 3.5.17, MyBatis-Spring 3.0.x, and the Spring Boot 3
          auto-configuration adapter through its own transitive tree; nothing here floats a version.
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus-spring-boot3-starter.version}</version>
        </dependency>

        <!--
          T35A1 default-off production OIDC identity boundary.

          These are pinned through the Spring Boot 3.5.16 BOM (Spring Security 6.5.11, Nimbus JOSE), so no
          floating version is introduced. The servlet security configuration, the OAuth2 Resource Server and the
          JOSE/JWT primitives are present on the classpath but every one of them stays dormant unless the host
          explicitly enables `campaign.production.enabled`. The production-disabled default publishes one explicit
          permit-all filter chain, so the framework's own web security auto-configuration cannot lock an existing
          route, and no generated user is created.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>${maven.compiler.parameters}</parameters>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8 -Duser.language=en -Duser.country=US</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <!-- Java 17 (the machine default) must fail the build, not silently downgrade the release. -->
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>Campaign AI Builder requires JDK 21. Set JAVA_HOME to a JDK 21 installation.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>Campaign AI Builder requires Maven 3.9 or newer.</message>
                                </requireMavenVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot-maven-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
