<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.campaign.persistence.mapper.CampaignMembershipPermissionMapper">

    <!--
      findPermissionsByMembershipId — Read every permission granted to one membership,
      ordered by the permission code so the caller gets a stable iteration order.
    -->
    <select id="findPermissionsByMembershipId" resultType="java.lang.String">
        select permission
          from campaign_membership_permission
         where membership_id = #{membershipId}
         order by permission
    </select>

</mapper>